// Per-packet view of the pgmoneta <- PostgreSQL (port 5432) connections: every segment that does NOT
// arrive in order, every receive-memory refusal, prune, drop and PostgreSQL retransmission, with
// sequence numbers. rx = pgmoneta socket (remote port 5432), tx = PostgreSQL socket (local port 5432).
kprobe:tcp_data_queue
{
  $sk = (struct sock *)arg0;
  if (bswap($sk->__sk_common.skc_dport) == 5432) {
    $tp = (struct tcp_sock *)arg0; $cb = (struct tcp_skb_cb *)((struct sk_buff *)arg1)->cb;
    if ($cb->seq != $tp->rcv_nxt) {
      printf("%s rx-ooo  port=%d seq=%u end=%u rcv_nxt=%u copied=%u rmem=%d rcvbuf=%d qlen=%u truesize=%u\n",
        strftime("%H:%M:%S", nsecs), $sk->__sk_common.skc_num, $cb->seq, $cb->end_seq, $tp->rcv_nxt, $tp->copied_seq,
        $sk->sk_backlog.rmem_alloc.counter, $sk->sk_rcvbuf, $sk->sk_receive_queue.qlen, ((struct sk_buff *)arg1)->truesize);
    }
  }
}
kprobe:tcp_try_rmem_schedule
{
  $sk = (struct sock *)arg0;
  if (bswap($sk->__sk_common.skc_dport) == 5432) { @rs_sk[tid] = arg0; @rs_skb[tid] = arg1; }
}
kretprobe:tcp_try_rmem_schedule /@rs_sk[tid]/
{
  if (retval != 0) {
    $sk = (struct sock *)@rs_sk[tid]; $tp = (struct tcp_sock *)@rs_sk[tid];
    $cb = (struct tcp_skb_cb *)((struct sk_buff *)@rs_skb[tid])->cb;
    printf("%s rx-nomem port=%d seq=%u end=%u rcv_nxt=%u %s rmem=%d rcvbuf=%d qlen=%u truesize=%u\n",
      strftime("%H:%M:%S", nsecs), $sk->__sk_common.skc_num, $cb->seq, $cb->end_seq, $tp->rcv_nxt,
      $cb->seq == $tp->rcv_nxt ? "IN-ORDER" : "ooo", $sk->sk_backlog.rmem_alloc.counter, $sk->sk_rcvbuf,
      $sk->sk_receive_queue.qlen, ((struct sk_buff *)@rs_skb[tid])->truesize);
  }
  delete(@rs_sk[tid]); delete(@rs_skb[tid]);
}
kprobe:tcp_prune_ofo_queue
{
  $sk = (struct sock *)arg0;
  if (bswap($sk->__sk_common.skc_dport) == 5432) {
    $tp = (struct tcp_sock *)arg0;
    printf("%s rx-prune-ofo port=%d rcv_nxt=%u rmem=%d rcvbuf=%d qlen=%u\n", strftime("%H:%M:%S", nsecs),
      $sk->__sk_common.skc_num, $tp->rcv_nxt, $sk->sk_backlog.rmem_alloc.counter, $sk->sk_rcvbuf, $sk->sk_receive_queue.qlen);
  }
}
tracepoint:skb:kfree_skb
{
  $skb = (struct sk_buff *)args.skbaddr;
  if ($skb->transport_header == 0xffff) { return; }
  $th = (struct tcphdr *)($skb->head + $skb->transport_header);
  if (bswap($th->source) == 5432 && args.reason > 2) {
    printf("%s rx-drop  port=%d seq=%u reason=%d at %s\n", strftime("%H:%M:%S", nsecs), bswap($th->dest),
      bswap($th->seq), args.reason, ksym(args.location));
  }
}
tracepoint:tcp:tcp_retransmit_skb /args.sport == 5432/
{
  $tp = (struct tcp_sock *)args.skaddr; $cb = (struct tcp_skb_cb *)((struct sk_buff *)args.skbaddr)->cb;
  printf("%s tx-retrans dport=%d seq=%u end=%u snd_una=%u snd_nxt=%u sacked=%u lost=%u cwnd=%u\n",
    strftime("%H:%M:%S", nsecs), args.dport, $cb->seq, $cb->end_seq, $tp->snd_una, $tp->snd_nxt,
    $tp->sacked_out, $tp->lost_out, $tp->snd_cwnd);
}
